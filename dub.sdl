name "cui-selector"
description "Selector UI simulator: a fuzzy picker drawn with the CUI C library"
authors "Christian Koestlin"
copyright "Copyright (c) 2026, Christian Koestlin"
license "MIT"
toolchainRequirements ldc=">=1.42.0" dmd="no" gdc="no"

dependency "argparse" version="~>2.0.2"
dependency "fuzzed" path="../14-fuzzed"
subConfiguration "fuzzed" "library"

configuration "application" {
    targetType "executable"
    targetPath "out/main/cui-selector"
    targetName "cui-selector"
    sourcePaths "source"
    importPaths "source"
    mainSourceFile "source/app.d"
    // CUI is built from the vendor/cui submodule, so local edits there are always used.
    preBuildCommands "cmake -S $PACKAGE_DIR/vendor/cui -B $PACKAGE_DIR/out/cui -DCUI_BUILD_EXAMPLES=OFF -DCUI_BUILD_TESTS=OFF -DCMAKE_BUILD_TYPE=Release" \
        "cmake --build $PACKAGE_DIR/out/cui"
    // Without these, dub sees an edit only in vendor/cui as up to date and skips the build.
    extraDependencyFiles "vendor/cui/CMakeLists.txt" "vendor/cui/include/cui/*.h" "vendor/cui/src/*.c" \
        "vendor/cui/src/*.h" "vendor/cui/src/platform/*"
    dflags "-P-I$PACKAGE_DIR/vendor/cui/include" platform="ldc"
    lflags "-L$PACKAGE_DIR/out/cui" "-lcui"
    lflags "-lX11" "-ldl" "-lm" "-lpthread" platform="linux"
    lflags "-framework" "Cocoa" "-framework" "QuartzCore" "-framework" "OpenGL" platform="osx"
}

configuration "unittest" {
    targetType "executable"
    targetPath "out/tests/cui-selector"
    targetName "cui-selector-tests"
    sourcePaths "source/selector" "tests"
    excludedSourceFiles "source/selector/window.d"
    importPaths "source" "tests"
    mainSourceFile "tests/runner.d"
    dependency "unit-threaded" version="~>2.2.6"
}
